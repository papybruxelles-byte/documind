# Never put these values in Vite / frontend environment variables.
OPENAI_API_KEY=your_openai_api_key
# Optional: use a model available to your OpenAI project.
OPENAI_MODEL=gpt-4.1-mini
# JSON from Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
# Your deployed frontend URL and local development URL, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173
